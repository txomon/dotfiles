+
+static inline struct propertyenum *impl_from_IEnumVARIANT_prop( IEnumVARIANT *iface )
+{
+    return CONTAINING_RECORD( iface, struct propertyenum, IEnumVARIANT_iface );
+}
+
+static HRESULT WINAPI propertyenum_QueryInterface( IEnumVARIANT *iface, REFIID riid, void **obj )
+{
+    struct propertyenum *propertyenum = impl_from_IEnumVARIANT_prop( iface );
+
+    TRACE( "%p %s %p\n", propertyenum, debugstr_guid(riid), obj );
+
+    if (IsEqualGUID( riid, &IID_IEnumVARIANT ) || IsEqualGUID( riid, &IID_IUnknown ))
+    {
+        *obj = iface;
+    }
+    else
+    {
+        WARN( "interface %s not implemented\n", debugstr_guid(riid) );
+        return E_NOINTERFACE;
+    }
+    IEnumVARIANT_AddRef( iface );
+    return S_OK;
+}
+
+static ULONG WINAPI propertyenum_AddRef( IEnumVARIANT *iface )
+{
+    struct propertyenum *propertyenum = impl_from_IEnumVARIANT_prop( iface );
+    return InterlockedIncrement( &propertyenum->refs );
+}
+
+static ULONG WINAPI propertyenum_Release( IEnumVARIANT *iface )
+{
+    struct propertyenum *propertyenum = impl_from_IEnumVARIANT_prop( iface );
+    LONG refs = InterlockedDecrement( &propertyenum->refs );
+    if (!refs)
+    {
+        ULONG i;
+        TRACE( "destroying %p\n", propertyenum );
+        for (i = 0; i < propertyenum->count; i++) SysFreeString( propertyenum->names[i] );
+        free( propertyenum->names );
+        IWbemClassObject_Release( propertyenum->object );
+        free( propertyenum );
+    }
+    return refs;
+}
+
+static HRESULT WINAPI propertyenum_Next( IEnumVARIANT *iface, ULONG celt, VARIANT *var, ULONG *fetched )
+{
+    struct propertyenum *propertyenum = impl_from_IEnumVARIANT_prop( iface );
+    HRESULT hr = S_OK;
+    ULONG i;
+
+    TRACE( "%p, %lu, %p, %p\n", iface, celt, var, fetched );
+
+    for (i = 0; i < celt && propertyenum->pos < propertyenum->count; i++)
+    {
+        ISWbemProperty *prop;
+
+        VariantInit( &var[i] );
+        hr = SWbemProperty_create( propertyenum->object, propertyenum->names[propertyenum->pos], &prop );
+        if (FAILED( hr )) break;
+        V_VT( &var[i] ) = VT_DISPATCH;
+        V_DISPATCH( &var[i] ) = (IDispatch *)prop;
+        propertyenum->pos++;
+    }
+    if (fetched) *fetched = i;
+    return (i < celt) ? S_FALSE : S_OK;
+}
+
+static HRESULT WINAPI propertyenum_Skip( IEnumVARIANT *iface, ULONG celt )
+{
+    struct propertyenum *propertyenum = impl_from_IEnumVARIANT_prop( iface );
+
+    TRACE( "%p, %lu\n", iface, celt );
+
+    if (propertyenum->pos + celt > propertyenum->count)
+    {
+        propertyenum->pos = propertyenum->count;
+        return S_FALSE;
+    }
+    propertyenum->pos += celt;
+    return S_OK;
+}
+
+static HRESULT WINAPI propertyenum_Reset( IEnumVARIANT *iface )
+{
+    struct propertyenum *propertyenum = impl_from_IEnumVARIANT_prop( iface );
+
+    TRACE( "%p\n", iface );
+
+    propertyenum->pos = 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI propertyenum_Clone( IEnumVARIANT *iface, IEnumVARIANT **penum )
+{
+    FIXME( "%p, %p\n", iface, penum );
     return E_NOTIMPL;
 }
 
+static const struct IEnumVARIANTVtbl propertyenum_vtbl =
+{
+    propertyenum_QueryInterface,
+    propertyenum_AddRef,
+    propertyenum_Release,
+    propertyenum_Next,
+    propertyenum_Skip,
+    propertyenum_Reset,
+    propertyenum_Clone
+};
+
+static HRESULT SWbemPropertyEnum_create( IWbemClassObject *object, IEnumVARIANT **obj )
+{
+    struct propertyenum *propertyenum;
+    ULONG capacity = 0;
+    BSTR name;
+    HRESULT hr;
+
+    if (!(propertyenum = malloc( sizeof(*propertyenum) ))) return E_OUTOFMEMORY;
+    propertyenum->IEnumVARIANT_iface.lpVtbl = &propertyenum_vtbl;
+    propertyenum->refs = 1;
+    propertyenum->object = object;
+    IWbemClassObject_AddRef( object );
+    propertyenum->names = NULL;
+    propertyenum->count = 0;
+    propertyenum->pos = 0;
+
+    hr = IWbemClassObject_BeginEnumeration( object, WBEM_FLAG_NONSYSTEM_ONLY );
+    if (SUCCEEDED( hr ))
+    {
+        while (IWbemClassObject_Next( object, 0, &name, NULL, NULL, NULL ) == S_OK)
+        {
+            if (propertyenum->count >= capacity)
+            {
+                ULONG new_capacity = capacity ? capacity * 2 : 16;
+                BSTR *new_names = realloc( propertyenum->names, new_capacity * sizeof(*new_names) );
+                if (!new_names) { SysFreeString( name ); break; }
+                propertyenum->names = new_names;
+                capacity = new_capacity;
+            }
+            propertyenum->names[propertyenum->count++] = name;
+        }
+        IWbemClassObject_EndEnumeration( object );
+    }
+
+    *obj = &propertyenum->IEnumVARIANT_iface;
+    TRACE( "returning iface %p\n", *obj );
+    return S_OK;
+}
+
+static HRESULT WINAPI propertyset_get__NewEnum( ISWbemPropertySet *iface, IUnknown **unk )
+{
+    struct propertyset *propertyset = impl_from_ISWbemPropertySet( iface );
+
+    TRACE( "%p, %p\n", propertyset, unk );
+
+    return SWbemPropertyEnum_create( propertyset->object, (IEnumVARIANT **)unk );
+}
