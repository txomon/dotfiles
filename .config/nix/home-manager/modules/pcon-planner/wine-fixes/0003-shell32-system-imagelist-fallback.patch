# pCon.planner fix — Wine dlls/shell32 (SHGetImageList)
# TARGETS: crash opening the Media Browser: EAccessViolation (read of 0x0) in
#   ShellBrowser.TJamSystemImageList.GetSize <- JamShellBreadCrumbBar. The Jam shell
#   breadcrumb bar requests a system image list size Wine doesn't populate
#   (SHIL_SYSSMALL/EXTRALARGE/JUMBO); Wine returns a NULL IImageList and the control
#   dereferences it. Falls back to a populated size (SMALL/LARGE). Independent.
# UPSTREAMABLE: yes (WineHQ dlls/shell32).
#
--- a/dlls/shell32/iconcache.c	2026-07-09 16:47:11.370195643 +0200
+++ b/dlls/shell32/iconcache.c	2026-07-09 16:46:24.064266071 +0200
@@ -1138,5 +1138,10 @@
         return E_FAIL;
 
     InitOnceExecuteOnce( &sic_init_once, SIC_Initialize, NULL, NULL );
+    /* Wine only populates SHIL_LARGE and SHIL_SMALL. Approximate the other sizes
+       (SHIL_EXTRALARGE / SHIL_SYSSMALL / SHIL_JUMBO) with a populated list so callers
+       get a valid IImageList instead of NULL (some apps do not null-check the result). */
+    if (!shell_imagelists[iImageList])
+        iImageList = (iImageList == SHIL_SYSSMALL) ? SHIL_SMALL : SHIL_LARGE;
     return HIMAGELIST_QueryInterface(shell_imagelists[iImageList], riid, ppv);
 }
