# written by home-manager (modules/bash)
/.bash_profile
/.bashrc
/.profile

# written by home-manager (modules/jetbrains)
/.ideavimrc

!/.config
/.config/*

!/.config/git/
/.config/git/gitk
# written by home-manager (modules/txomon-git)
/.config/git/config
/.config/git/ignore

!/.config/nix/

# written by home-manager (modules/elvish)
/.config/elvish/

# written by home-manager (modules/starship)
/.config/starship.toml


# Claude Code: deny everything, then re-include only the portable config.
# Everything else under .claude/ is credentials, session/project history,
# plugins or cache, and must never reach a public remote.
!/.claude/
/.claude/*
!/.claude/CLAUDE.md
!/.claude/settings.json
!/.claude/agents/
/.claude/agents/*
!/.claude/agents/*.md

# Safety net. These patterns are unanchored, so they apply at every depth and
# catch credential files in any tool directory that gets whitelisted later.
.credentials.json
credentials/
auth.json
oauth_creds.json
google_accounts.json
*.pem
*.p12
*.pfx
*.jks
*.keystore
id_rsa
id_dsa
id_ecdsa
id_ed25519

