#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""Whitelist a player on the ATM10 (gandalf) server using the correct OFFLINE UUID.

The server is online-mode=false, so `/whitelist add <name>` stores the wrong
(Mojang online) UUID and the player still gets "not white-listed". This computes
the name-derived offline UUID the player actually logs in with, writes it straight
into whitelist.json, and reloads — bypassing Mojang entirely. Also repairs an
existing entry that has the wrong UUID.

Usage:
  atm10-whitelist-add <name> [<name> ...]
  atm10-whitelist-add --dry-run <name>     # show UUIDs, change nothing
"""
import hashlib
import json
import re
import subprocess
import sys
import uuid
from datetime import datetime, timezone

HOST = "gandalf"
CONTAINER = "all-the-mods-10"
WL = "/srv/minecraft/all-the-mods-10/whitelist.json"


def offline_uuid(name: str) -> str:
    """UUID.nameUUIDFromBytes("OfflinePlayer:"+name) — Minecraft's offline UUID."""
    md5 = bytearray(hashlib.md5(("OfflinePlayer:" + name).encode("utf-8")).digest())
    md5[6] = (md5[6] & 0x0F) | 0x30  # version 3
    md5[8] = (md5[8] & 0x3F) | 0x80  # RFC 4122 variant
    return str(uuid.UUID(bytes=bytes(md5)))


def ssh(*remote_argv: str, stdin: str | None = None) -> str:
    r = subprocess.run(
        ["ssh", HOST, *remote_argv],
        input=stdin,
        text=True,
        capture_output=True,
    )
    if r.returncode != 0:
        sys.exit(f"ssh {' '.join(remote_argv)} failed ({r.returncode}):\n{r.stderr.strip()}")
    return r.stdout


def rcon(command: str) -> str:
    out = ssh(f"podman exec {CONTAINER} rcon-cli {command}")
    return re.sub(r"\x1b\[[0-9;]*m", "", out).strip()  # strip ANSI


def main() -> None:
    args = sys.argv[1:]
    dry_run = False
    if args and args[0] in ("--dry-run", "-n"):
        dry_run = True
        args = args[1:]
    names = args
    if not names:
        sys.exit(__doc__)

    entries = json.loads(ssh(f"cat {WL}"))
    by_name = {e["name"].lower(): e for e in entries}

    changes: list[str] = []
    for name in names:
        if not re.fullmatch(r"[A-Za-z0-9_]{1,16}", name):
            print(f"! {name!r}: unusual name (not 1-16 word chars) — adding anyway")
        want = offline_uuid(name)
        existing = by_name.get(name.lower())
        if existing is None:
            entries.append({"uuid": want, "name": name})
            changes.append(f"+ {name}: added {want}")
        elif existing["uuid"].lower() != want.lower():
            changes.append(f"~ {name}: {existing['uuid']} -> {want}")
            existing["uuid"] = want
            existing["name"] = name  # normalize display case
        else:
            print(f"= {name}: already correct ({want})")

    if dry_run:
        print("\n[dry-run] would change:" if changes else "\n[dry-run] nothing to change")
        for c in changes:
            print("  " + c)
        return

    if not changes:
        print("\nNothing to change; skipping write and reload.")
        return

    new_content = json.dumps(entries, indent=2) + "\n"
    stamp = datetime.now(timezone.utc).strftime("%Y%m%d%H%M%S")
    ssh(
        f"cp {WL} {WL}.bak-{stamp} && cat > {WL}.tmp && mv {WL}.tmp {WL}",
        stdin=new_content,
    )
    print(f"\nWrote {WL} (backup {WL}.bak-{stamp}):")
    for c in changes:
        print("  " + c)

    print("\nReloading whitelist...")
    print("  " + rcon("whitelist reload"))
    print("  " + rcon("whitelist list"))


if __name__ == "__main__":
    main()
